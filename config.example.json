{
  "schema_version": "1.1",
  "kind": "config_example",
  "_notes": "真实 config.json 由此模板生成并替换 apiKey（config.json 已 gitignore，不入库）。apiKey 支持环境变量 LLM_API_KEY / TAVILY_API_KEY 覆盖。",
  "project_root": ".",
  "llm": {
    "provider": "spark-dsv4",
    "baseUrl": "http://222.128.103.10:18080/api/v1",
    "apiKey": "sk-REPLACE_ME",
    "models": {
      "flash": "deepseek-v4-flash-0731",
      "pro": "deepseek-v4-pro"
    },
    "default_model": "flash"
  },
  "budget": {
    "context_total": 524288,
    "input_hard_cap": 400000,
    "target": 256000,
    "rule_bundle_tokens": 40000,
    "auto_retry": 3
  },
  "web": {
    "search_provider": "tavily",
    "apiKey": "tvly-REPLACE_ME",
    "search": {"max_results": 5, "timeout": 20},
    "extract": {"depth": "basic", "timeout": 30},
    "download_dir": "storge/datasheet"
  },
  "paths": {
    "raw": "raw",
    "roles": "roles",
    "rules": "rules",
    "src": "src",
    "web": "web",
    "project_dir": "project",
    "storge": {
      "refbook": "storge/refbook",
      "datasheet": "storge/datasheet",
      "products": "storge/project",
      "problem": "storge/problem"
    }
  },
  "conventions": {
    "_notes": "EDA 约定与阈值（可选；缺省用代码 common/conventions.py 的 DEFAULTS）。只需写想覆盖的键，启动时自动生效。",
    "active_prefixes": ["U"],
    "connector_prefixes": ["J", "CN", "P", "CON"],
    "mech_prefixes": ["H", "MH"],
    "testpoint_prefixes": ["TP"],
    "passive_prefixes": ["R", "C", "L", "FB", "D", "Q", "Y", "X", "F", "BEAD", "LED", "SW"],
    "transparent_prefixes": ["R", "L", "BEAD", "FB", "FERR", "TP", "JMP", "JUMP", "0R"],
    "power_net_regex": "^(GND|AGND|DGND|VSS|VCC|VDD|VBAT|VIN|VBUS|\\+|-)\\d*",
    "diff_pair_regex": "^(.*?)[_\\-]?([PN])$",
    "board_regex": "-([A-Z])_V\\d",
    "board_fallback_regex": "-([A-Z])_",
    "connector_pair_min_signal": 3,
    "fanout_min_neighbors": 3,
    "trace_guard": 60
  }
}
